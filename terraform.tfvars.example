# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is excluded from version control to prevent secrets from
# being committed accidentally.

project_name = "myapp"
environment  = "dev"
aws_region   = "us-east-1"

# Networking
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]

# Compute
instance_type    = "t3.micro"
ami_id           = ""   # leave empty to use the latest Amazon Linux 2023 AMI
min_size         = 1
max_size         = 4
desired_capacity = 2
key_name         = ""   # leave empty if you don't need SSH access
