# ============================================================
# Environment Variables Template
# Copy this file to .env.local for local development
# NEVER commit .env.local or any file with real credentials
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=3000
APP_NAME=your-app-name
APP_VERSION=1.0.0-local

# ---- Database (PostgreSQL) ----
# Local development (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT=30000

# For staging/production, use the read replica for read-heavy operations
# DATABASE_READ_URL=postgresql://postgres:password@read-replica.xxx.rds.amazonaws.com:5432/appdb

# ---- Cache (Redis) ----
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
# REDIS_AUTH_TOKEN=  # Required for ElastiCache in production

# ---- Authentication ----
# Must be at least 32 characters, randomly generated
JWT_SECRET=local-dev-secret-key-replace-with-32-plus-char-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---- AWS Configuration ----
AWS_REGION=us-east-1
# Leave blank for local development (uses LocalStack instead)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# LocalStack endpoint for local development
AWS_ENDPOINT=http://localhost:4566

# ---- S3 Storage ----
AWS_S3_BUCKET=your-app-dev-uploads
AWS_S3_REGION=us-east-1
AWS_CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net

# ---- Secrets Manager (production only) ----
# In production, these are fetched from AWS Secrets Manager at startup
# SECRETS_MANAGER_PREFIX=production/app

# ---- Email (optional) ----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=noreply@yourdomain.com

# ---- Logging & Monitoring ----
LOG_LEVEL=debug
# Sentry error tracking (get DSN from sentry.io)
# SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# ---- CORS & Security ----
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Feature Flags ----
FEATURE_NEW_ONBOARDING=false
FEATURE_BETA_DASHBOARD=false

# ---- Third-party APIs (replace with actual keys) ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
